*.pem
*.key
*.keystore
*.jks
*.mobileprovision
*.provisionprofile
id_rsa*
id_ed25519*
*.ppk
credentials.json
secrets.json
.netrc

# Environment and machine-local configuration
.env
.env.*
!.env.example
.npmrc
.mcp.json
.tool-versions.local

