{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Manager",
  "version": "0.2.0",
  "identifier": "tools.aimanager.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm run dev:renderer",
    "beforeBuildCommand": "pnpm run build:renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "",
        "titleBarStyle": "Overlay",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; form-action 'none'; frame-src 'none'; object-src 'none'; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "AI Manager",
    "homepage": "https://aimanager.tools",
    "copyright": "Copyright © 2026 AI Manager contributors. Licensed under AGPL-3.0-or-later.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENSE": "LICENSE",
      "../licenses/LICENSE-MIT": "LICENSE-MIT",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "wix": {
        "template": "wix/per-user-main.wxs"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["aimanager"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNGQjhBM0ZDQTc1RDJFNDQKUldSRUxsMm4vS080UHpKN1Bidkc1VzRKYkloRFI3TWo4YVJoYVdDUjhMZUNpYjZVd3dlemJ1dU4K",
      "endpoints": ["https://dl.aimanager.tools/ai-manager/latest.json"]
    }
  }
}
